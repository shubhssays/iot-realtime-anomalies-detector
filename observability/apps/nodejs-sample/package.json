{
  "name": "nodejs-sample-app",
  "version": "1.0.0",
  "description": "Sample Node.js app instrumented with OpenTelemetry",
  "main": "index.js",
  "scripts": {
    "start": "node --require ./tracing.js index.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/sdk-node": "^0.49.1",
