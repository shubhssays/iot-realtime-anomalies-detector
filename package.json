{
  "name": "iot-realtime-anomalies-detector",
  "version": "1.0.0",
  "description": "Real-time IoT anomaly detection system with Kafka, Flink, TimescaleDB, ClickHouse and WebSocket alerts",
  "author": "Shubh <shubhssays>",
  "license": "MIT",
  "homepage": "https://github.com/shubhssays/iot-realtime-anomalies-detector#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhssays/iot-realtime-anomalies-detector.git"
  },
  "bugs": {
    "url": "https://github.com/shubhssays/iot-realtime-anomalies-detector/issues"
  },
  "keywords": [
    "iot",
    "anomaly-detection",
    "real-time",
    "kafka",
    "redpanda",
    "flink",
    "timescaledb",
    "clickhouse",
    "websocket",
    "streaming"
  ],
  "type": "module",
  "dependencies": {
    "@clickhouse/client": "^1.16.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "kafkajs": "^2.2.4",
    "pg": "^8.17.2",
    "undici": "^7.19.1",
    "ws": "^8.18.0"
  },
  "scripts": {
    "setup": "cd docker && docker compose up -d && echo 'Waiting for databases to start...' && sleep 10 && cd ../scripts && node create-kafka-topics.js && node create-timeseries-db-tables.js && node create-clickhouse-db-tables.js",
    "start": "concurrently \"node apps/node-backend/listener/telemetry-listener.js\" \"node apps/node-backend/listener/anomaly-listener.js\" \"node apps/node-backend/simulator/iot-firehose.js\"",
    "start:frontend": "npx -y http-server apps/frontend -p 8080 -c-1",
    "deploy:flink": "cd scripts && node deploy-flink.js",
    "purge": "cd scripts && node purge-db.js && node purge-kafka.js"
  }
}