{
  "name": "iot-realtime-anomalies-detector",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@clickhouse/client": "^1.16.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "kafkajs": "^2.2.4",
    "pg": "^8.17.2",
    "undici": "^7.19.1",
    "ws": "^8.18.0"
  },
  "scripts": {
    "deploy_flink": "cd scripts && node deploy-flink.js",
    "purge_dbs": "cd scripts && node purge-db.js",
    "purge_kafka": "cd scripts && node purge-kafka.js",
    "docker_up": "cd docker && docker compose up -d",
    "start_telemetry_listener": "node apps/node-backend/listener/telemetry-listener.js",
    "start_anomaly_listener": "node apps/node-backend/listener/anomaly-listener.js",
    "start_frontend": "npx -y http-server apps/frontend -p 8080 -c-1",
    "start_simulator": "concurrently \"yarn start_telemetry_listener\" \"yarn start_anomaly_listener\" \"node apps/node-backend/simulator/iot-firehose.js\"",
    "first_time_init": "cd scripts && node create-kafka-topics.js && node create-timeseries-db-tables.js && node create-clickhouse-db-tables.js",
    "start_all": "yarn docker_up && yarn first_time_init && concurrently \"yarn start_telemetry_listener\" \"yarn start_anomaly_listener\" \"node apps/node-backend/simulator/iot-firehose.js\""
  }
}