# OpenObserve Configuration
OPENOBSERVE_URL=http://openobserve:5080
OPENOBSERVE_ORG=default
OPENOBSERVE_USER=admin@example.com
OPENOBSERVE_PASSWORD=Admin@123

# OpenObserve Authentication (Base64 encoded user:password)
# Generated by: echo -n "admin@example.com:Admin@123" | base64
OPENOBSERVE_AUTH=YWRtaW5AZXhhbXBsZS5jb206QWRtaW5AMTIz

# OpenTelemetry Collector
OTEL_COLLECTOR_ENDPOINT=http://otel-collector:4318

# Application Settings
NODE_ENV=production
